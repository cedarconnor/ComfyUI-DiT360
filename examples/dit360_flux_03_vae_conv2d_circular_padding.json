      "size": [580, 220],
      "flags": {},
      "order": 1,
      "mode": 0,
      "inputs": [],
      "outputs": [],
      "properties": {},
      "widgets_values": [
        "If you still see a seam:\\n- Increase EdgeBlender.blend_width (10-40).\\n- Optionally add small KSampler circular padding (8-16).\\n\\nIf output quality drops:\\n- Keep KSampler circular_padding at 0.\\n- Prefer full FLUX dev over fp8."
      ],
      "color": "#432",
      "bgcolor": "#653"
    },
